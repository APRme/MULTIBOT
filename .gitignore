# Dependencies
node_modules/

# Runtime caches and auth/session data
auth-cache/
sessions/

# Runtime outputs
logs/
replays/
memory_dump/

# Local-only replay recorder implementation and its direct tests
/flashback-recorder/
/test/flashbackRecorderCapabilities.test.js
/test/flashbackRecorderState.test.js

# Local bot instances may contain account names, server details, and private whitelists.
BOTS/

# Local operator scripts (kept on disk and synced to the server, never versioned)
/scripts/

# Local config overrides
*.local.json
*.local.js

# Production master config contains local tokens and paths.
multibot.config.json

# Bark push credentials (keys must never be committed)
/.env
**/.env

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local agent scratch area and pending-delete holding area (never versioned)
/.temp/
/.pending-delete/

# Test scratch output
/test/.tmp/

# Local warehouse runtime data (rules + sqlite); keep out of the public repo
/WareHouse/

# Reasonix auto-generated files
.reasonix/

# Workspace-local agent instructions (maintained locally, not versioned)
/AGENTS.md

# npm debug output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
